{{define "nav"}}
<nav>
  <div>
    <a href='/'>home</a>
    {{ if .CanWriteImages }}
    <a href='/image/store'>tuck image</a>
    {{ end  }}
  </div>
  <div>
    {{ if .CurrentUser }}
    <span>{{ .CurrentUser.Name }}</span>
    <form action='/user/logout' method='POST'>
      <button type='submit'>logout</button>
    </form>
    {{ else }}
    <a href='/user/login'>login</a>
    {{ end }}
  </div>
</nav>
{{end}}
